APP_TITLE="{{ remrg:var project-name }}"
PORT=4111

# Mastra
OPENAI_API_KEY=""

# Models
LOCAL_MODEL_URL="http://localhost:11434/v1"
LOCAL_STABLEDIFFUSION_URL="http://localhost:7860/api/txt2img"

# Environment variables for PostgreSQL container setup
POSTGRES_DB="{{ remrg:var project-name }}"
POSTGRES_USER="{{ remrg:var project-name }}"
POSTGRES_PASSWORD=""

# Optional local host access when starting only the database.
# POSTGRES_PORT=5432

# Host-side npm run dev / db:setup connections. URL-encode credentials.
# Both URLs may point to the same database, using separate schemas.
# Example: postgresql://<user>:<encoded-password>@127.0.0.1:5432/<database>
DATABASE_URL=""
OBSERVABILITY_DATABASE_URL=""

# Optional provisioning login on the same server; used only by db:setup.
DATABASE_ADMIN_URL=""
